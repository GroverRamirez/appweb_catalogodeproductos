APP_NAME="PC Store Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Desarrollo: con 0.0.0.0, `composer run dev` sirve la app tambien a otros
# equipos de la WiFi en http://IP-de-la-PC:8020
# SERVER_HOST=0.0.0.0

APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Arrancar worker en producción (procesar la cola de notificaciones primero):
#   php artisan queue:work --queue=notifications,default --tries=3 --timeout=90

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Login con Google para clientes (Google Cloud Console > Credenciales > ID de
# cliente OAuth 2.0, tipo "Aplicación web"). URI de redireccion autorizada:
#   {APP_URL}/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/login/google/callback"

VITE_APP_NAME="${APP_NAME}"

# Cotizacion oficial del dolar (BCB). API publica, sin clave.
BCB_TC_URL=https://apibcb.cucu.bo/api/v1/tc/oficial
BCB_TC_TIMEOUT=10

# Copias de seguridad desde el panel (vacio = autodetectar mysqldump)
MYSQLDUMP_PATH=
BACKUP_TIMEOUT=300
