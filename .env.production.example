# ─────────────────────────────────────────────────────────────────────────────
# .env.production.example
# Copy to .env and fill in real values before deploying.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Catálogo de Productos"
APP_ENV=production
APP_KEY=                          # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://tu-dominio.com
APP_PORT=80                       # Host port mapped to container's 80

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql                     # Docker service name
DB_PORT=3306
DB_DATABASE=catalogo
DB_USERNAME=catalogo
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis                  # Docker service name
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Cache / Session / Queue ──────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=catalogo_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Storage ──────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# For S3-compatible storage (optional):
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ─── Vite (build-time only) ───────────────────────────────────────────────────
VITE_APP_URL="${APP_URL}"
