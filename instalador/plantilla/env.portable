APP_NAME="PC Store Pro"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8020
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/La_Paz

# La base es un archivo dentro de la carpeta: no hay servicio que instalar.
DB_CONNECTION=sqlite

# Todo en archivos y en el mismo proceso: sin colas ni servicios de fondo, la
# app arranca y funciona con solo abrir el acceso directo.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Los correos quedan escritos en storage/logs: la demo no manda nada afuera.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="tienda@pcstorepro.test"
MAIL_FROM_NAME="${APP_NAME}"

# Cotizacion del dolar: si la PC de prueba no tiene internet, la app sigue
# andando con la ultima cotizacion que viajo en la base.
BCB_TC_URL=https://apibcb.cucu.bo/api/v1/tc/oficial
BCB_TC_TIMEOUT=10
